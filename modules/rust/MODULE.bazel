module(
    name = "rules_proto_grpc_rust",
    version = "0.0.0.rpg.version.placeholder",
    compatibility_level = 1,
)

bazel_dep(name = "grpc", version = "1.65.0")
bazel_dep(name = "protobuf", version = "29.0")
bazel_dep(name = "rules_proto", version = "7.0.2")
bazel_dep(name = "rules_rust", version = "0.58.0")
bazel_dep(name = "rules_proto_grpc", version = "0.0.0.rpg.version.placeholder")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(package = "async-stream", version = "0.3.6")
crate.spec(package = "futures", version = "0.3.31")
crate.spec(package = "pbjson", version = "0.7.0")
crate.spec(package = "pbjson-types", version = "0.7.0")
crate.spec(package = "prost", version = "0.13.5")
crate.spec(package = "prost-derive", version = "0.13.5")
crate.spec(package = "prost-types", version = "0.13.5")
crate.spec(package = "protoc-gen-prost", version = "0.4.0", artifact = "bin")
crate.spec(package = "protoc-gen-prost-crate", version = "0.4.1", artifact = "bin")
crate.spec(package = "protoc-gen-prost-serde", version = "0.3.1", artifact = "bin")
crate.spec(package = "protoc-gen-tonic", version = "0.4.1", artifact = "bin")
crate.spec(package = "rand", version = "0.9.0")
crate.spec(package = "serde", version = "1.0.219")
crate.spec(package = "serde_json", version = "1.0.140")
crate.spec(package = "tokio", version = "1.44.0")
crate.spec(package = "tokio-stream", version = "0.1.17")
crate.spec(package = "tonic", version = "0.12.3")
crate.spec(package = "tonic-build", version = "0.12.3")
crate.annotation(crate = "protoc-gen-prost", gen_all_binaries = True)
crate.annotation(crate = "protoc-gen-prost-crate", gen_all_binaries = True)
crate.annotation(crate = "protoc-gen-prost-serde", gen_all_binaries = True)
crate.annotation(crate = "protoc-gen-tonic", gen_all_binaries = True)
crate.from_specs(host_tools_repo = "rust_host_tools_nightly")
use_repo(crate, "crates")
