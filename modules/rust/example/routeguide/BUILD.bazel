load("//rust:defs.bzl", "rust_prost_proto_library", "rust_tonic_grpc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_prost_proto_library(
    name = "routeguide_prost",
    declared_proto_packages = ["routeguide"],
    options = {
        "//:rust_prost_plugin": ["type_attribute=.routeguide.Point=#[derive(Eq\\,Hash)]"],
    },
    protos = ["//example/proto:routeguide_proto"],
)

rust_tonic_grpc_library(
    name = "routeguide_tonic",
    declared_proto_packages = ["routeguide"],
    options = {
        "//:rust_prost_plugin": ["type_attribute=.routeguide.Point=#[derive(Eq\\,Hash)]"],
    },
    protos = ["//example/proto:routeguide_proto"],
)

rust_binary(
    name = "client",
    srcs = [
        "client.rs",
    ],
    data = ["//example/proto:routeguide_features"],
    edition = "2021",
    visibility = ["//example/routeguide:__pkg__"],
    deps = [
        ":routeguide_tonic",
        "@crate:async-stream",
        "@crate:futures",
        "@crate:rand",
        "@crate:tokio",
        "@crate:tonic",
    ],
)

rust_binary(
    name = "server",
    srcs = [
        "data.rs",
        "server.rs",
    ],
    data = ["//example/proto:routeguide_features"],
    edition = "2021",
    visibility = ["//example/routeguide:__pkg__"],
    deps = [
        ":routeguide_tonic",
        "@crate:async-stream",
        "@crate:futures",
        "@crate:serde",
        "@crate:serde_json",
        "@crate:tokio",
        "@crate:tokio-stream",
        "@crate:tonic",
    ],
)
